@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="avatar avatar-xl bg-primary mb-3" style="width: 70px; height: 70px;">
                        <span class="avatar-content fs-1 text-white"><i class="bi bi-person-fill"></i></span>
                    </div>
                    <h3 class="auth-title">Giriş Yap</h3>
                    <p class="auth-subtitle text-muted">Blackjack masasına dönmek için hesabınıza giriş yapın.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold" role="alert"></div>
                    
                    <!-- E-posta Input -->
                    <div class="form-group position-relative has-icon-left mb-4">
                        <input asp-for="Input.Email" class="form-control form-control-xl" autocomplete="username" aria-required="true" placeholder="E-posta Adresi" />
                        <div class="form-control-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <!-- Şifre Input -->
                    <div class="form-group position-relative has-icon-left mb-4">
                        <input asp-for="Input.Password" class="form-control form-control-xl" autocomplete="current-password" aria-required="true" placeholder="Şifre" />
                        <div class="form-control-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Beni Hatırla -->
                    <div class="form-check form-check-lg d-flex align-items-center mb-4">
                        <input class="form-check-input me-2" asp-for="Input.RememberMe" type="checkbox" id="flexCheckDefault">
                        <label class="form-check-label text-gray-600" for="flexCheckDefault">
                            Beni Hatırla
                        </label>
                    </div>
                    
                    <button id="login-submit" type="submit" class="btn btn-primary btn-block btn-lg shadow mt-3 w-100 rounded-pill">
                        Giriş Yap
                    </button>
                </form>
                
                <div class="text-center mt-5 fs-6">
                    <p class="text-gray-600 mb-2">
                        Hesabınız yok mu? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-primary text-decoration-none">Kayıt Ol</a>
                    </p>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="font-bold text-secondary text-decoration-none">Şifremi Unuttum</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}