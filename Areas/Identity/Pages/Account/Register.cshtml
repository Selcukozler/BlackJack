@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <!-- Kayıt Ol İkonu -->
                    <div class="avatar avatar-xl bg-success mb-3" style="width: 70px; height: 70px;">
                        <span class="avatar-content fs-1 text-white"><i class="bi bi-person-plus-fill"></i></span>
                    </div>
                    <h3 class="auth-title">Kayıt Ol</h3>
                    <p class="auth-subtitle text-muted">Blackjack masasına katılmak için yeni bir hesap oluşturun.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold" role="alert"></div>
                    
                    <!-- E-posta Input -->
                    <div class="form-group position-relative has-icon-left mb-4">
                        <input asp-for="Input.Email" class="form-control form-control-xl" autocomplete="username" aria-required="true" placeholder="E-posta Adresi" />
                        <div class="form-control-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <!-- Şifre Input -->
                    <div class="form-group position-relative has-icon-left mb-4">
                        <input asp-for="Input.Password" class="form-control form-control-xl" autocomplete="new-password" aria-required="true" placeholder="Şifre" />
                        <div class="form-control-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Şifre Tekrar Input -->
                    <div class="form-group position-relative has-icon-left mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-xl" autocomplete="new-password" aria-required="true" placeholder="Şifreyi Onayla" />
                        <div class="form-control-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <button id="registerSubmit" type="submit" class="btn btn-success btn-block btn-lg shadow mt-3 w-100 rounded-pill">
                        Kayıt Ol
                    </button>
                </form>
                
                <div class="text-center mt-5 fs-6">
                    <p class="text-gray-600 mb-0">
                        Zaten bir hesabınız var mı? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-success text-decoration-none">Giriş Yap</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}