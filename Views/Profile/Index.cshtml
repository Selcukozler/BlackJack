@model BlackJack.Models.ApplicationUser
@{
    ViewData["Title"] = "Oyuncu Profili";
    var history = ViewBag.History as List<BlackJack.Models.GameHistory>;
}

<div class="row">
    <!-- Kullanıcı Kartı -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body py-4 px-4 text-center">
                <div class="avatar avatar-xl bg-primary mb-3" style="width: 80px; height: 80px;">
                    <span class="avatar-content fs-2 text-white">@Model.Email.Substring(0, 1).ToUpper()</span>
                </div>
                <h4 class="card-title">@Model.Email</h4>
                <p class="text-muted">Kayıtlı Oyuncu</p>
                
                <hr>
                
                <div class="d-flex justify-content-between align-items-center mt-4 px-3">
                    <h6 class="mb-0">Cüzdan Bakiyesi:</h6>
                    <span class="badge bg-warning text-dark fs-5 px-3 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-coin me-1"></i> @Model.TotalChips Çip
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Oyun Geçmişi Tablosu -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h4 class="card-title mb-0"><i class="bi bi-clock-history me-2"></i>Son Oyun Geçmişi</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Bahis</th>
                                <th>Sonuç</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (history != null && history.Any())
                            {
                                foreach (var game in history)
                                {
                                    <tr>
                                        <td class="text-nowrap">@game.PlayDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="fw-bold">@game.BetAmount</td>
                                        <td>
                                            @if (game.Result.Contains("Kazan"))
                                            {
                                                <span class="badge bg-success">Kazandı</span>
                                            }
                                            else if (game.Result.Contains("Kaybet") || game.Result.Contains("Bust") || game.Result.Contains("Kurpiyer"))
                                            {
                                                <span class="badge bg-danger">Kaybetti</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Berabere</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">Henüz hiç oyun oynamadınız.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>