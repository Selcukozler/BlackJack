@using Microsoft.AspNetCore.Identity
@using BlackJack.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="navbar-nav align-items-center ms-auto">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    
    <div class="nav-item me-3">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
            Çip: @(user?.TotalChips ?? 0)
        </span>
    </div>
    
    <div class="nav-item dropdown">
        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
            <span class="d-none d-md-inline-flex">@User.Identity?.Name</span>
        </a>
        <div class="dropdown-menu dropdown-menu-end bg-secondary border-0 rounded-0 rounded-bottom m-0">
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="dropdown-item">Profil</a>
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Game", new { area = "" })">
                <button type="submit" class="dropdown-item">Çıkış Yap</button>
            </form>
        </div>
    </div>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Register" class="nav-item nav-link">Kayıt Ol</a>
    <a asp-area="Identity" asp-page="/Account/Login" class="nav-item nav-link">Giriş Yap</a>
}
</div>