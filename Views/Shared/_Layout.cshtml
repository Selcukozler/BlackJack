<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Blackjack</title>
    
    <!-- Mazer CSS Dosyaları -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/bootstrap.css">
    <link rel="stylesheet" href="/assets/vendors/iconly/bold.css">
    <link rel="stylesheet" href="/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app">
        <!-- SOL MENÜ (Sidebar) -->
        <div id="sidebar" class="active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header">
                    <div class="d-flex justify-content-between">
                        <div class="logo">
                            <a asp-controller="Game" asp-action="Index"><h3 class="text-primary mt-2">Blackjack</h3></a>
                        </div>
                        <div class="toggler">
                            <a href="#" class="sidebar-hide d-xl-none d-block"><i class="bi bi-x bi-middle"></i></a>
                        </div>
                    </div>
                </div>
                <div class="sidebar-menu">
                    <ul class="menu">
    <li class="sidebar-title">Oyunlar</li>
    
    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Game" ? "active" : "")">
        <a asp-controller="Game" asp-action="Index" class='sidebar-link'>
            <i class="bi bi-suit-spade-fill text-dark"></i>
            <span>Blackjack</span>
        </a>
    </li>

    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pisti" ? "active" : "")">
        <a asp-controller="Pisti" asp-action="Index" class='sidebar-link'>
            <i class="bi bi-suit-club-fill text-primary"></i>
            <span>Pişti</span>
        </a>
    </li>

    <li class="sidebar-title">Diğer</li>

    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leaderboard" ? "active" : "")">
        <a asp-controller="Leaderboard" asp-action="Index" class='sidebar-link'>
            <i class="bi bi-trophy-fill text-warning"></i>
            <span>Liderlik Tablosu</span>
        </a>
    </li>
    
    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active" : "")">
        <a asp-controller="Profile" asp-action="Index" class='sidebar-link'>
            <i class="bi bi-person-badge-fill text-info"></i>
            <span>Profilim</span>
        </a>
    </li>
</ul>
                </div>
                <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
            </div>
        </div>
        
        <!-- ANA İÇERİK ALANI -->
        <div id="main" class='layout-navbar'>
            
            <!-- ÜST MENÜ (Navbar) -->
            <header class='mb-3'>
                <nav class="navbar navbar-expand navbar-light ">
                    <div class="container-fluid">
                        <a href="#" class="burger-btn d-block">
                            <i class="bi bi-justify fs-3"></i>
                        </a>

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        
                        <div class="collapse navbar-collapse" id="navbarSupportedContent">
                            <div class="navbar-nav ms-auto mb-2 mb-lg-0">
                                <!-- Üst menü sağ taraftaki kullanıcı bilgileri ve çıkış butonu -->
                                <partial name="_LoginPartial" />
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
            
            <!-- SAYFA İÇERİĞİ -->
            <div id="main-content">
                <div class="page-heading">
                    <div class="page-title">
                        <div class="row">
                            <div class="col-12 col-md-6 order-md-1 order-last">
                                <h3>@ViewData["Title"]</h3>
                            </div>
                        </div>
                    </div>
                    
                    <section class="section mt-4">
                        @RenderBody()
                    </section>
                </div>

                <footer>
                    <div class="footer clearfix mb-0 text-muted">
                        <div class="float-start">
                            <p>2026 &copy; Blackjack Casino</p>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>
    
    <!-- JavaScript Kütüphaneleri -->
    <script src="/assets/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="/assets/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/main.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
   <!-- Sayfa Yenilendiğinde Kaydırma (Scroll) Pozisyonunu Koruyan Script - YUMUŞATILDI -->
    <script>
        document.addEventListener("DOMContentLoaded", function(event) { 
            var scrollpos = sessionStorage.getItem('scrollpos');
            var scrollUrl = sessionStorage.getItem('scrollUrl');
            
            if (scrollpos && scrollUrl === window.location.href) {
                // Hızlı zıplama yerine, ekranı anında oraya odaklar ve animasyonların titretmesini önler
                window.scrollTo({
                    top: parseInt(scrollpos),
                    left: 0,
                    behavior: "instant" 
                });
            }
        });

        window.addEventListener("beforeunload", function (e) {
            sessionStorage.setItem('scrollpos', window.scrollY);
            sessionStorage.setItem('scrollUrl', window.location.href);
        });
    </script>
</body>
</html>