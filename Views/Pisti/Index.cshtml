@{
    ViewData["Title"] = "Pişti - Bahis Seçimi";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-center rounded-top py-4">
                <h3 class="mb-0 text-white"><i class="bi bi-suit-club-fill me-2"></i>Pişti Masası</h3>
            </div>
            <div class="card-body mt-4 text-center px-5">
                <p class="text-muted fs-5 mb-4">Kartları topla, Pişti yap! Başlamak için bahsini seç.</p>
                
                <form method="post" asp-controller="Pisti" asp-action="Start">
                    <div class="row justify-content-center mb-4">
                        <div class="col-12 d-flex justify-content-center gap-3 flex-wrap">
                            <button type="button" class="btn btn-outline-secondary rounded-pill fw-bold px-4 py-2 bet-btn" data-val="10">10 Çip</button>
                            <button type="button" class="btn btn-outline-info rounded-pill fw-bold px-4 py-2 bet-btn" data-val="50">50 Çip</button>
                            <button type="button" class="btn btn-outline-warning rounded-pill fw-bold px-4 py-2 bet-btn" data-val="100">100 Çip</button>
                            <button type="button" class="btn btn-outline-danger rounded-pill fw-bold px-4 py-2 bet-btn" data-val="500">500 Çip</button>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <div class="input-group input-group-lg shadow-sm rounded">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-cash-coin text-success fs-4"></i></span>
                            <input type="number" id="pistiBetAmount" name="betAmount" class="form-control text-center fw-bold fs-4 border-0" placeholder="Miktar Girin" required min="1">
                        </div>
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="text-danger mt-2 fw-bold">
                                @Html.ValidationSummary(false, "", new { @class = "list-unstyled" })
                            </div>
                        }
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow">
                        <i class="bi bi-play-circle-fill me-2"></i>Kartları Dağıt
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.bet-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('pistiBetAmount').value = this.getAttribute('data-val');
        });
    });
</script>